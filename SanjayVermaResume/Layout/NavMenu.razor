@inject IJSRuntime JSRuntime

<nav class="navbar navbar-expand-lg fixed-top portfolio-nav">
    <div class="container">
        <a class="navbar-brand" href="#">
            <span class="brand-text">SV</span>
        </a>
        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="@NavMenuCssClass navbar-collapse" @onclick="ToggleNavMenu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#home" @onclick="@(() => ScrollToSection("home"))">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#about" @onclick="@(() => ScrollToSection("about"))">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#impact" @onclick="@(() => ScrollToSection("impact"))">Impact</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#technical" @onclick="@(() => ScrollToSection("technical"))">Technical</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#experience" @onclick="@(() => ScrollToSection("experience"))">Experience</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contact" @onclick="@(() => ScrollToSection("contact"))">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task ScrollToSection(string sectionId)
    {
        collapseNavMenu = true;
        await JSRuntime.InvokeVoidAsync("scrollToElement", sectionId);
    }
}
