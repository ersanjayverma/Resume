<!-- Certificate Modal -->
@if (isModalOpen)
{
    <div class="certificate-modal-overlay" @onclick="CloseCertificateModal">
        <div class="certificate-modal" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="CloseCertificateModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z" />
                </svg>
            </button>
            <div class="modal-image-container">
                <img src="@selectedCertificateImage" alt="@selectedCertificateTitle" />
            </div>
            <h3 class="modal-title">@selectedCertificateTitle</h3>
        </div>
    </div>
}

@code {
    private bool isModalOpen = false;
    private string selectedCertificateImage = "";
    private string selectedCertificateTitle = "";

    private void OpenCertificateModal(string imagePath, string title)
    {
        selectedCertificateImage = imagePath;
        selectedCertificateTitle = title;
        isModalOpen = true;
    }

    private void CloseCertificateModal()
    {
        isModalOpen = false;
        selectedCertificateImage = "";
        selectedCertificateTitle = "";
    }
}
